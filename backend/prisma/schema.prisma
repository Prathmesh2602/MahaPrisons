generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model PageNode {
  id           String         @id @default(uuid())
  slug         String         @unique
  title        String
  description  String?
  seoTitle     String?
  seoDesc      String?
  layoutType   String         @default("standard")
  isActive     Boolean        @default(true)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  contentBlocks ContentBlock[]
}

model ContentBlock {
  id          String    @id @default(uuid())
  pageNodeId  String
  pageNode    PageNode  @relation(fields: [pageNodeId], references: [id], onDelete: Cascade)
  blockType   String    // e.g. "hero", "text", "gallery", "accordion"
  order       Int       @default(0)
  content     Json      // Stores the specific data schema for the block type
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([pageNodeId])
}
