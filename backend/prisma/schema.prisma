generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model PageNode {
  id            String         @id @default(uuid())
  slug          String         @unique
  title         String
  description   String?
  seoTitle      String?
  seoDesc       String?
  layoutType    String         @default("standard")
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  contentBlocks ContentBlock[]
}

model ContentBlock {
  id         String   @id @default(uuid())
  pageNodeId String
  blockType  String
  order      Int      @default(0)
  content    Json
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  pageNode   PageNode @relation(fields: [pageNodeId], references: [id], onDelete: Cascade)

  @@index([pageNodeId])
}

model Menu {
  id        String     @id @default(uuid())
  name      String     @unique
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  items     MenuItem[]
}

model MenuItem {
  id        String     @id @default(uuid())
  menuId    String
  parentId  String?
  label_mr  String
  label_en  String
  href      String?
  icon      String?
  order     Int        @default(0)
  groups    Json?
  isActive  Boolean    @default(true)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  menu      Menu       @relation(fields: [menuId], references: [id], onDelete: Cascade)
  parent    MenuItem?  @relation("MenuHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children  MenuItem[] @relation("MenuHierarchy")

  @@index([menuId])
  @@index([parentId])
}

model SiteSetting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model User {
  id        String     @id @default(uuid())
  email     String     @unique
  password  String
  name      String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  role      Role       @default(MAKER)
  revisions Revision[] @relation("CreatedRevisions")
  reviews   Revision[] @relation("ReviewedRevisions")
}

model Revision {
  id            String       @id @default(uuid())
  modelName     String
  recordId      String?
  proposedData  Json
  status        ReviewStatus @default(PENDING_REVIEW)
  rejectReason  String?
  createdById   String
  reviewedById  String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  changeSummary String?
  createdBy     User         @relation("CreatedRevisions", fields: [createdById], references: [id])
  reviewedBy    User?        @relation("ReviewedRevisions", fields: [reviewedById], references: [id])

  @@index([modelName, recordId])
  @@index([status])
}

model Media {
  id        String   @id @default(uuid())
  filename  String
  filepath  String
  mimetype  String
  size      Int
  url       String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum Role {
  MAKER
  CHECKER
  SUPER_ADMIN
}

enum ReviewStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  REJECTED
}
